{
  "$defs": {
    "Constraint": {
      "additionalProperties": false,
      "description": "A functional form tying a series' parameters to its endpoints.\n\nThis is what the hand-written ``linear_constraints()`` does, declared\ninstead of coded: each slice's value becomes an expression in the endpoint\nparameters, so only the endpoints are free.\n\nAttributes:\n    series: The series this applies to.\n    form: The functional form. See :mod:`nr_workbench.spec.constraints`.\n    paths: Parameter paths to constrain. Globs allowed, e.g. ``*.roughness``.\n    from_: State supplying the starting value, for interpolating forms.\n    to: State supplying the final value.\n    knots: Number of free knots, for ``piecewise_linear``.\n    endpoint_range: Bounds for an endpoint written as ``free``. Needed\n        only when the path has no other declaration to borrow from -- a\n        series with no bracketing steady states.\n    tau: Bounds for the time constant, for ``exponential``.\n    t_half: Bounds for the midpoint, for ``logistic``.\n    width: Bounds for the transition width, for ``logistic``.",
      "properties": {
        "series": {
          "title": "Series",
          "type": "string"
        },
        "form": {
          "title": "Form",
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        },
        "knots": {
          "default": 3,
          "title": "Knots",
          "type": "integer"
        },
        "endpoint_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Range"
        },
        "tau": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tau"
        },
        "t_half": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Half"
        },
        "width": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "series",
        "form",
        "paths"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "FitSettings": {
      "additionalProperties": false,
      "description": "Default fit settings recorded with the model.\n\nAttributes:\n    method: Which fitter, ``amoeba`` or ``dream``. See\n        :mod:`nr_workbench.fitters` for why those are the only two.\n    steps: Maximum optimizer steps.\n    samples: DREAM sample count.\n    burn: DREAM burn-in.\n    seed: Random seed.",
      "properties": {
        "method": {
          "default": "amoeba",
          "title": "Method",
          "type": "string"
        },
        "steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        },
        "samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Samples"
        },
        "burn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Burn"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "FitSettings",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One slab in the stack.\n\nAttributes:\n    name: Layer name; how it is addressed in paths, and how the generated\n        script indexes the refl1d sample.\n    material: Key into ``materials``. Defaults to the layer name.\n    thickness: Starting thickness in Angstroms. Ignored for the ambient\n        and substrate, which are semi-infinite.\n    roughness: Starting interfacial roughness in Angstroms.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "thickness": {
          "default": 0.0,
          "title": "Thickness",
          "type": "number"
        },
        "roughness": {
          "default": 0.0,
          "title": "Roughness",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "Layer",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "A material's scattering length density.\n\nAttributes:\n    rho: Real SLD in 1e-6 A^-2.\n    irho: Imaginary SLD (absorption).\n    formula: Chemical formula, for SLD lookup when ``rho`` is omitted.\n    density: Mass density in g/cm^3, used with ``formula``.",
      "properties": {
        "rho": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rho"
        },
        "irho": {
          "default": 0.0,
          "title": "Irho",
          "type": "number"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "density": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Density"
        }
      },
      "title": "Material",
      "type": "object"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "description": "One free or fixed parameter.\n\nAttributes:\n    path: What it addresses, e.g. ``Cu.thickness`` or ``probe.intensity``.\n    per: How it is shared. See the module docstring.\n    in_: Restrict to these states or series. ``None`` means all of them.\n    range: Bounds as ``[min, max]``.\n    value: Starting value. Defaults to the stack's.\n    pm: Symmetric bounds around ``value``, as an alternative to ``range``.\n    fixed: Pin to ``value`` and do not fit it.\n    init: ``stack`` takes the starting value from the layer definition.\n    name: Override the generated parameter name.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "per": {
          "default": "state",
          "enum": [
            "model",
            "state",
            "measurement",
            "angle"
          ],
          "title": "Per",
          "type": "string"
        },
        "in": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "pm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pm"
        },
        "fixed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed"
        },
        "init": {
          "anyOf": [
            {
              "const": "stack",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Init"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "path"
      ],
      "title": "ParameterSpec",
      "type": "object"
    },
    "Probe": {
      "additionalProperties": false,
      "description": "How the probe is constructed from the data.\n\nAttributes:\n    resolution: Only ``angular_only``: dT is derived from dQ at the known\n        incident angle and dL is zero. See the class body for why the\n        moderator variant was dropped.\n    dq_is_fwhm: Whether the 4th data column is FWHM. Read it off the file's\n        column titles rather than assuming; treating FWHM as sigma scales\n        every resolution by 2.355.\n    dq_scale: Constant factor applied to the dQ column, for a reduction whose\n        resolution estimate is demonstrably wrong. Fixed rather than fitted;\n        see the note in the class body.\n    back_reflection: Neutrons enter through the substrate.",
      "properties": {
        "resolution": {
          "const": "angular_only",
          "default": "angular_only",
          "title": "Resolution",
          "type": "string"
        },
        "dq_is_fwhm": {
          "default": true,
          "title": "Dq Is Fwhm",
          "type": "boolean"
        },
        "dq_scale": {
          "default": 1.0,
          "title": "Dq Scale",
          "type": "number"
        },
        "back_reflection": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Back Reflection"
        }
      },
      "title": "Probe",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "One angle segment of a steady-state measurement.\n\nAttributes:\n    file: Path to the reduced data, relative to the project root.\n    theta: Incident angle in degrees -- theta, not two-theta.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "theta": {
          "title": "Theta",
          "type": "number"
        }
      },
      "required": [
        "file",
        "theta"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Series": {
      "additionalProperties": false,
      "description": "A time-resolved measurement: a state with a time axis.\n\nAttributes:\n    name: Identifier used in paths, ``in`` lists and ``constraints.series``.\n    condition: Free text, e.g. \"during EIS\".\n    run: Run number.\n    reduced_dir: Directory of reduced slices, relative to the project root.\n    theta: Incident angle in degrees. tNR is a single angle.\n    select: Which slices to include.\n    time_from: Where slice times come from. ``filename`` parses\n        ``r<run>_t<seconds>.txt``; ``reduction_json`` reads the sidecar,\n        which is the only source that also carries interval types.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "condition": {
          "default": "",
          "title": "Condition",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "reduced_dir": {
          "title": "Reduced Dir",
          "type": "string"
        },
        "theta": {
          "default": 0.6,
          "title": "Theta",
          "type": "number"
        },
        "select": {
          "$ref": "#/$defs/SeriesSelect"
        },
        "time_from": {
          "default": "filename",
          "enum": [
            "filename",
            "reduction_json"
          ],
          "title": "Time From",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reduced_dir"
      ],
      "title": "Series",
      "type": "object"
    },
    "SeriesSelect": {
      "additionalProperties": false,
      "description": "Which slices of a time-resolved run to include.\n\nAttributes:\n    t_start: First slice time in seconds.\n    t_stop: Last slice time in seconds, inclusive.\n    t_step: Spacing in seconds.\n    labels: Explicit interval labels or fnmatch globs, instead of a time range.\n    interval_types: Restrict to these interval types, e.g. ``[hold]``.",
      "properties": {
        "t_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Start"
        },
        "t_stop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Stop"
        },
        "t_step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Step"
        },
        "labels": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labels"
        },
        "interval_types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Types"
        }
      },
      "title": "SeriesSelect",
      "type": "object"
    },
    "State": {
      "additionalProperties": false,
      "description": "A steady-state measurement of the sample under one condition.\n\nAttributes:\n    name: Identifier used in paths and ``in`` lists.\n    condition: Free text, e.g. \"OCV before EIS\". Carried into the record.\n    run: Run number, used to resolve ``segments: auto``.\n    kind: ``partials`` (one file per angle) or ``combined``.\n    segments: Explicit segment list, or ``auto`` to resolve from ``run``.\n    thetas: Angles for ``segments: auto``.\n    data_dir: Directory holding the files, relative to the project root.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "condition": {
          "default": "",
          "title": "Condition",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "kind": {
          "default": "partials",
          "enum": [
            "partials",
            "combined"
          ],
          "title": "Kind",
          "type": "string"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Segment"
              },
              "type": "array"
            },
            {
              "const": "auto",
              "type": "string"
            }
          ],
          "default": "auto",
          "title": "Segments"
        },
        "thetas": {
          "items": {
            "type": "number"
          },
          "title": "Thetas",
          "type": "array"
        },
        "data_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Dir"
        }
      },
      "required": [
        "name"
      ],
      "title": "State",
      "type": "object"
    },
    "Trim": {
      "additionalProperties": false,
      "description": "A range of the data to keep, for one measurement or all of them.\n\nSome data is wrong in a way no parameter can absorb. A segment whose required\nscale varies *across* its own wavelength band --- typically at the short-\u03bb\nedge, where the direct-beam spectrum is weakest --- cannot be fixed by\n``probe.intensity``, which is one number per segment. Left in, the fit spends\na thickness or a roughness on it. The honest options are to re-reduce or to\ncut the band, and until now cutting meant ``nrw model fork``, which takes the\nmodel out of the spec entirely for the sake of two numbers.\n\nCuts are declared here so they stay in the spec, get hashed with it, and\nappear in the generated script's own docstring. Dropping data must never be\ninvisible.\n\n**\u03bb and Q are not interchangeable across segments.** A band-edge problem is a\nproperty of the wavelength, and one \u03bb cut maps to a different Q in every\nsegment: at 0.37\u00b0 \u03bb = 3.5 \u00c5 is Q = 0.023, at 3.5\u00b0 it is Q = 0.219. State it\nin \u03bb and it is right everywhere; state it in Q and it is right once.\n\nAttributes:\n    in_: Measurements this applies to, as state names or ``state#index``\n        keys. ``None`` means every measurement.\n    q_min: Drop points below this Q.\n    q_max: Drop points above this Q.\n    lambda_min: Drop points below this wavelength, in angstroms.\n    lambda_max: Drop points above this wavelength.\n    reason: Why the data is being cut. Required: a silent cut is\n        indistinguishable from a mistake six months later.",
      "properties": {
        "in": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In"
        },
        "q_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q Min"
        },
        "q_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q Max"
        },
        "lambda_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lambda Min"
        },
        "lambda_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lambda Max"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Trim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A neutron reflectometry model: one layer stack, any number of steady-state states and time-resolved series, with functional constraints across a series.",
  "properties": {
    "schema": {
      "const": "nrw-model/1",
      "title": "Schema",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "sample": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "materials": {
      "additionalProperties": {
        "$ref": "#/$defs/Material"
      },
      "title": "Materials",
      "type": "object"
    },
    "stack": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "title": "Stack",
      "type": "array"
    },
    "probe": {
      "$ref": "#/$defs/Probe"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/State"
      },
      "title": "States",
      "type": "array"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/Series"
      },
      "title": "Series",
      "type": "array"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/ParameterSpec"
      },
      "title": "Parameters",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/Constraint"
      },
      "title": "Constraints",
      "type": "array"
    },
    "trim": {
      "items": {
        "$ref": "#/$defs/Trim"
      },
      "title": "Trim",
      "type": "array"
    },
    "fit": {
      "$ref": "#/$defs/FitSettings"
    },
    "post_build": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Build"
    }
  },
  "required": [
    "schema",
    "name",
    "stack"
  ],
  "title": "nrw-model/1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
